<!-- The Noetic half of the Isaac-only closed loop: perception + TreeMapper + the corridor navigator + the recorder.
     Started by scripts/sim_mission.sh inside tm_sim_ros (roscore and the ros1_bridge parameter_bridge are already up,
     /use_sim_time is true before any node starts):
       roslaunch corridor_nav_ros sim_closed_loop.launch run_dir:=<run dir> detector_model:=<onnx>
     The run directory must hold field.yaml and corridor_nav.cfg (sim_mission.sh writes both); the bag goes to
     <run_dir>/mission.bag.

     Detector settings are the parity-checked ones (results/corridor_nav_isaac.md "Detector parity"): the Isaac YOLOX-s
     model takes [1, 3, 416, 640], grey replicated to 3 channels (the drone's camera is grey), its output is already
     grid-decoded, and the existing detector keeps boxes with score >= 0.8.

     Recording: an explicit allow-list (never "everything": the disparity images are ~1 MB each at 10 Hz). It holds
     what tools/treemapper_tools/mission_score.py reads (/tf, /mission_state, /spray_target, /corridor_nav/spray,
     /corridor_nav/status, /treemapper/map, /treemapper/stage_timing, /sim/deposition, the three timing streams) plus
     /tf_static, /corridor_nav/setpoint, the plan markers, /sim/truth, the detections and the perception counters.
     record_images:=true adds the left image throttled to 0.2 Hz on /rec/left_0p2hz.
     record_frames:=true adds what treemapper_node consumes besides the detections, /tf and the phase / target topics
     above: the left / right half-resolution camera_info, /rec/disparity_grid and its /disparity_grid/counters (with the
     /stereo_sgbm/timing already recorded they give the exact number of images lost on the way), made by sim_perception's
     disparity_grid_node from /disparity_image_down_float. That node republishes only the stride-4 pixels the TreeMapper
     node samples (~64 kB instead of ~1 MB per image); the full image is NOT recorded, and the TreeMapper node keeps
     consuming the full image. The harness option record-frames of scripts/sim_mission.sh sets it, converts the bag to
     frames.bin with tools/treemapper_tools/sim_frames.py and then replaces the bag by a copy without these topics. -->
<launch>
  <arg name="run_dir"/>
  <arg name="detector_model"/>
  <arg name="field_file" default="$(arg run_dir)/field.yaml"/>
  <arg name="config_file" default="$(arg run_dir)/corridor_nav.cfg"/>
  <arg name="bag" default="$(arg run_dir)/mission.bag"/>
  <arg name="record" default="true"/>
  <arg name="record_images" default="false"/>
  <arg name="record_frames" default="false"/>
  <arg name="detector_device" default="cuda"/>
  <arg name="detector_score_threshold" default="0.8"/>
  <!-- sim/specs/camera.json "mount" (optical -> body), as treemapper_sim.launch has it -->
  <arg name="camera_mount" default="[0.15000002475785956, 0.07999961110446568, -2.6425180287698025e-07, -0.7071065073147165, 0.7071070550580697, 1.315609245066774e-07, 5.193386764157588e-07]"/>
  <arg name="output" default="screen"/>

  <param name="/use_sim_time" value="true"/>

  <include file="$(find sim_perception)/launch/sim_perception.launch">
    <arg name="detector_model" value="$(arg detector_model)"/>
    <arg name="device" value="$(arg detector_device)"/>
    <arg name="input_size" value="[416, 640]"/>
    <arg name="input_channels" value="3"/>
    <arg name="decoded" value="true"/>
    <arg name="score_threshold" value="$(arg detector_score_threshold)"/>
    <arg name="output" value="$(arg output)"/>
  </include>

  <include file="$(find treemapper_ros)/launch/treemapper_sim.launch">
    <arg name="use_sim_time" value="true"/>
    <arg name="output" value="$(arg output)"/>
  </include>

  <include file="$(find corridor_nav_ros)/launch/corridor_nav.launch">
    <arg name="field_file" value="$(arg field_file)"/>
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="camera_mount" value="$(arg camera_mount)"/>
    <arg name="camera_frame_is_optical" value="true"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="output" value="$(arg output)"/>
  </include>

  <arg if="$(arg record_images)" name="rec_image_topic" value="/rec/left_0p2hz"/>
  <arg unless="$(arg record_images)" name="rec_image_topic" value=""/>
  <arg if="$(arg record_frames)" name="rec_frame_topics"
       value="/rec/disparity_grid /disparity_grid/counters /cam/bottom/left/half/camera_info /cam/bottom/right/half/camera_info"/>
  <arg unless="$(arg record_frames)" name="rec_frame_topics" value=""/>
  <group if="$(arg record)">
    <node if="$(arg record_frames)" pkg="sim_perception" type="disparity_grid_node.py" name="disparity_grid"
          output="$(arg output)">
      <param name="in_topic" value="/disparity_image_down_float"/>
      <param name="out_topic" value="/rec/disparity_grid"/>
      <param name="stride" value="4"/>
    </node>
    <node if="$(arg record_images)" pkg="topic_tools" type="throttle" name="rec_left_throttle"
          args="messages /cam/bottom/left/half/image_raw 0.2 /rec/left_0p2hz"/>
    <!-- SIGINT from roslaunch's shutdown closes the bag (sim_mission.sh stops the launch before the containers) -->
    <node pkg="rosbag" type="record" name="mission_recorder" output="log"
          args="--lz4 -O $(arg bag)
                /tf /tf_static
                /mission_state /spray_target
                /corridor_nav/setpoint /corridor_nav/spray /corridor_nav/status /corridor_nav/timing
                /corridor_nav/plan_markers
                /treemapper/map /treemapper/stage_timing /treemapper/health
                /sim/truth /sim/deposition
                /object_detection/detections /detector/timing
                /stereo_sgbm/timing /stereo_sgbm/counters
                $(arg rec_image_topic) $(arg rec_frame_topics)"/>
  </group>
</launch>
